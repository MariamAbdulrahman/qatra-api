{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Qatra.Api",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Qatra.Api/Qatra.Api.csproj",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}