{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Reporting": {
    "DailyReportLimit": 10
  },
  "PredictionService": {
    "BaseUrl": "https://qatra-ml-service.onrender.com",
    "PredictPath": "/predict",
    "TimeoutSeconds": 60,
    "CacheMinutes": 30
  },
  "AiExtraction": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 30
  },
  "AiExplanation": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 30
  },
  "ReportProcessing": {
    "PollSeconds": 15,
    "BatchSize": 5,
    "DelayBetweenReportsSeconds": 15
  },
  "Incidents": {
    "MergeWindowHours": 72,
    "RepeatWindowHours": 72,
    "ExpirationHours": 72
  },
  "Ranking": {
    "W1Volume": 0.35,
    "W2Duration": 0.30,
    "W3Recency": 0.20,
    "W4Severity": 0.15,
    "RecencyWindowHours": 72.0
  }
}
